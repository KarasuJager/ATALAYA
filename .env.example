# Optional: Shodan API key (free account: https://account.shodan.io)
# Leave empty to skip Shodan
SHODAN_API_KEY=

# ---- Atalaya v3 (intel) ----
# GitHub: token de solo lectura (fine-grained, sin permisos de escritura). Lo usan code search, github-subdomains/endpoints y trufflehog.
GITHUB_TOKEN=
# urlscan.io (opcional, sube el límite de búsquedas)
URLSCAN_API_KEY=
# bbscope: scope de la plataforma con tu sesión (incluye privados). Solo aquí, nunca en git.
BBSCOPE_H1_USER=
BBSCOPE_H1_TOKEN=
# BBSCOPE_BC_TOKEN: cookie _bugcrowd_session
BBSCOPE_BC_TOKEN=
# BBSCOPE_IT_TOKEN: token personal de Intigriti
BBSCOPE_IT_TOKEN=
# BBSCOPE_YWH_TOKEN: bearer de YesWeHack
BBSCOPE_YWH_TOKEN=
# Saltar módulos: ct,urlscan,github,ghtools,postman,program,bbscope,chaos,dns,internetdb,archivedjs,sourcemaps,jsluice,trufflehog,dockerhub,buckets
INTEL_SKIP=
# Postman (opcional): sin clave la búsqueda ya devuelve lo público
POSTMAN_API_KEY=
